# Copy this file to .env.local for local development and add the same secrets in Vercel.

# Session signing secret. Generate a long random value.
AUTH_SECRET=

# Public application URL used for Flutterwave redirects.
APP_URL=http://localhost:3000

# Flutterwave server credentials.
FLW_SECRET_KEY=
FLW_WEBHOOK_HASH=

# Admin seeding script defaults. Do not commit real passwords.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# OpenAI. Keep all OpenAI credentials server-side.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
OPENAI_TTS_SPEED=1
# OPENAI_TTS_INSTRUCTIONS=Warm, eloquent female career coach. Natural, calm and encouraging. Normal conversational pace.

# Supabase Postgres. The service role key is server-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=generate-a-long-random-secret
NEXT_PUBLIC_SITE_URL=http://localhost:3000

GOOGLE_APPS_SCRIPT_URL=
CRON_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional live FX endpoint. Defaults to open.er-api.com if omitted.
EXCHANGE_RATE_API_URL=

RESUMEEFY_DEMO_MODE=true
