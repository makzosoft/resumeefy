# Copy this file to .env.local for local development and add the same
# variables in Vercel Project Settings. Do not commit real secrets.
#
# .env.local.example has the same variables with placeholder-style values —
# use whichever template you prefer, but keep BOTH files in sync if you edit
# one. A missing variable here was a real cause of confusing "Supabase keeps
# erroring" symptoms in the past, so don't skip any of the required ones.

# Public application URL used for Flutterwave redirects and metadata.
APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (required) ---
# All three are required. SUPABASE_ANON_KEY specifically is easy to miss —
# without it, src/lib/auth.ts throws at startup and EVERY signup/login
# request fails, even though Supabase itself is configured correctly.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Never prefix this with NEXT_PUBLIC_ or expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Flutterwave (required for payments) ---
FLW_SECRET_KEY=
FLW_WEBHOOK_HASH=

# --- Admin seeding script (scripts/seed-admin.mjs) ---
# ADMIN_PASSWORD has no default — the script refuses to run without one, on
# purpose. Do not commit a real password here.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# --- Google Gemini (required for all AI features) ---
# Resumeefy uses Gemini, not OpenAI — there is no OPENAI_API_KEY anywhere in
# this app. Comma-separate multiple keys to round-robin across them as quota
# is used up: GEMINI_API_KEYS=key_one,key_two,key_three
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash

# --- Optional integrations ---
# Vercel Cron / Supabase Cron shared secret for POST /api/blog?action=autopublish.
CRON_SECRET=
# Google Apps Script analytics endpoint (see code.gs). Leave blank to disable.
GOOGLE_APPS_SCRIPT_URL=
# Overrides the default open.er-api.com FX source for international pricing.
EXCHANGE_RATE_API_URL=

# Run locally without real Supabase/Gemini/Flutterwave credentials, using an
# in-memory demo data store and simulated payments. Never enable in production.
RESUMEEFY_DEMO_MODE=false
# Client-visible twin of the flag above — set to the SAME value. This one
# only controls whether the "Skip sign-in" dev button renders on the
# login/signup pages; RESUMEEFY_DEMO_MODE above is what actually makes the
# bypass work server-side. Set BOTH to false (or remove both) before
# deploying to production — leaving this on ships a visible dev-only button
# to real users even though the bypass itself would still 404 if the
# server-side flag is off.
NEXT_PUBLIC_RESUMEEFY_DEMO_MODE=false
