# Resumeefy environment template.
# Fill these values locally and add the same variables in Vercel Project Settings.
# Do not commit real secrets.

APP_URL=http://localhost:3000

# Supabase backend
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
OPENAI_TTS_SPEED=1

# Flutterwave
FLW_SECRET_KEY=
FLW_WEBHOOK_HASH=

# Admin bootstrap
ADMIN_EMAIL=admin@resumeefy.site
ADMIN_NAME=Resumeefy Admin
ADMIN_PASSWORD=change-this-before-production

# Optional live FX endpoint. Defaults to open.er-api.com if omitted.
EXCHANGE_RATE_API_URL=
