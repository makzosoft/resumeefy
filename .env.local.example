# Resumeefy environment template.
# Fill these values locally and add the same variables in Vercel Project Settings.
# Do not commit real secrets. (See .env.example for the same variables with
# more detailed comments — keep both files in sync if you edit one.)

APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase backend — all three are required.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Google Gemini — required for all AI features (resume generation, scoring,
# job matching, interview coaching, courses, blog). Not OpenAI.
GEMINI_API_KEYS=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash

# Flutterwave
FLW_SECRET_KEY=
FLW_WEBHOOK_HASH=

# Admin bootstrap (scripts/seed-admin.mjs). No default password — required.
ADMIN_EMAIL=admin@resumeefy.site
ADMIN_NAME=Resumeefy Admin
ADMIN_PASSWORD=

# Optional
CRON_SECRET=
GOOGLE_APPS_SCRIPT_URL=
# Optional live FX endpoint. Defaults to open.er-api.com if omitted.
EXCHANGE_RATE_API_URL=
RESUMEEFY_DEMO_MODE=false
# Set to the SAME value as above to show the "Skip sign-in" dev button on
# login/signup. Turn both off before deploying — see .env.example for why.
NEXT_PUBLIC_RESUMEEFY_DEMO_MODE=false
